# Copy to .env for local development. Never commit real values.
# On Render, set these in the dashboard (they are marked sync: false in render.yaml).

PORT=10000
# Where model weights are served from. On Render this is the persistent disk.
MODELS_DIR=./.models

# Narration (scripts/narration.mjs). Used only on your machine, never shipped to the app.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Later phases
# TINKER_API_KEY=
# SENTRY_DSN=
# HF_TOKEN=
